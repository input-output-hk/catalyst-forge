{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5173",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"analyze": "vite build && node scripts/analyze.mjs",
		"api:gen": "swagger2openapi -p ../foundry/api/docs/swagger.yaml -o src/lib/api/openapi.json && openapi-typescript src/lib/api/openapi.json -o src/lib/api/types.ts",
		"biome:check": "biome check src",
		"biome:fix": "biome check --apply src",
		"e2e": "playwright test",
		"e2e:dev": "start-server-and-test dev http://localhost:5173 e2e"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.1.4",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@playwright/test": "^1.54.2",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/typography": "^0.5.15",
		"@tailwindcss/vite": "^4.0.0",
		"@testing-library/jest-dom": "^6.6.4",
		"@testing-library/svelte": "^5.2.8",
		"@testing-library/user-event": "^14.6.1",
		"@vitest/browser": "^3.2.3",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"openapi-typescript": "^7.8.0",
		"playwright": "^1.53.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"rollup-plugin-visualizer": "^6.0.3",
		"start-server-and-test": "^2.0.13",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"swagger2openapi": "^7.0.8",
		"tailwindcss": "^4.0.0",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.20.0",
		"vite": "^7.0.4",
		"vitest": "^3.2.3",
		"vitest-browser-svelte": "^0.1.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"@tanstack/svelte-query": "^5.83.1",
		"@tanstack/table-core": "^8.21.3",
		"openapi-fetch": "^0.14.0",
		"replicate": "^1.0.1"
	}
}
