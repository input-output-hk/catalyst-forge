{
    "$id": "https://forge-test.projectcatalyst.io/schemas/identity.default.schema.json",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Default Identity Schema",
    "type": "object",
    "properties": {
        "traits": {
            "type": "object",
            "properties": {
                "email": {
                    "type": "string",
                    "format": "email",
                    "ory.sh/kratos": {
                        "credentials": {
                            "passkey": {
                                "display_name": true
                            }
                        }
                    }
                },
                "domain": {
                    "type": "string"
                }
            },
            "required": [
                "email",
                "domain"
            ],
            "additionalProperties": false
        }
    }
}