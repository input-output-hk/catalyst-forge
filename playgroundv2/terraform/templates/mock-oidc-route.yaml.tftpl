apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: mock-oidc
  namespace: ${mock_oidc_namespace}
spec:
  parentRefs:
  - name: ${gateway_name}
    namespace: ${gateway_namespace}
  hostnames:
  - ${hostname}
  rules:
  - matches:
    - path:
        type: PathPrefix
        value: /
    backendRefs:
    - name: mock-oidc
      namespace: ${mock_oidc_namespace}
      port: ${service_port}


