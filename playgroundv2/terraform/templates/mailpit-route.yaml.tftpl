apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: mailpit
  namespace: ${mailpit_namespace}
spec:
  parentRefs:
  - name: ${gateway_name}
    namespace: ${gateway_namespace}
  hostnames:
  - ${hostname}
  rules:
  - backendRefs:
    - name: ${service_name}
      namespace: ${mailpit_namespace}
      port: ${ui_port}


