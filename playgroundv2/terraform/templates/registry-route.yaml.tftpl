apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: registry
  namespace: ${registry_namespace}
spec:
  parentRefs:
  - name: ${gateway_name}
    namespace: ${gateway_namespace}
  hostnames:
  - ${hostname}
  rules:
  - backendRefs:
    - name: registry-docker-registry
      namespace: ${registry_namespace}
      port: 5000

