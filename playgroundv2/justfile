# Justfile for local playgroundv2: K3d + Helmfile (Envoy Gateway, registry)

PROJROOT := justfile_directory()

default:
	@just --list

# Create or reuse local cluster and write kubeconfig/cluster.json
k3d:
	cd "{{PROJROOT}}/cli" && PYTHONPATH="{{PROJROOT}}/.." uv run python -m playgroundv2.cli.main k3d --yes

# Pin registry.projectcatalyst.dev to local cluster
pin-registry:
	cd "{{PROJROOT}}/cli" && PYTHONPATH="{{PROJROOT}}/.." uv run python -m playgroundv2.cli.main dns pin-registry --host registry.projectcatalyst.dev

# Generate local TLS certs and Earthly config
generate:
	cd "{{PROJROOT}}/cli" && PYTHONPATH="{{PROJROOT}}/.." uv run python -m playgroundv2.cli.main generate

# Initialize PostgreSQL for dependent apps
migrate:
	cd "{{PROJROOT}}/cli" && PYTHONPATH="{{PROJROOT}}/.." uv run python -m playgroundv2.cli.main migrate

# Create or reuse local cluster and write kubeconfig/cluster.json
up: k3d apply pin-registry generate migrate deploy-all

# Tear down cluster
down name="forge":
    cd "{{PROJROOT}}/cli" && PYTHONPATH="{{PROJROOT}}/.." uv run python -m playgroundv2.cli.main down --name {{name}}

# Apply base platform
apply:
	cd "{{PROJROOT}}/helmfile" && helmfile apply

# Sync base platform
sync:
	cd "{{PROJROOT}}/helmfile" && helmfile sync

# Build, push, and deploy a service to the cluster
deploy service="api":
	./scripts/deploy.sh {{service}}

deploy-all:
	just deploy api
	just deploy frontend

# Run lint, formatting (check-only), and type checks
check:
	#!/usr/bin/env bash
	set -euo pipefail
	cd "{{PROJROOT}}/cli"
	# Ensure tools resolve via uv without requiring a pre-synced venv
	uv run ruff check .
	uv run black --check .
	# Run mypy using uv; set PYTHONPATH so package imports resolve
	PYTHONPATH="{{PROJROOT}}/.." uv run mypy .

# CLI: auto-format and fix lint issues
format:
	#!/usr/bin/env bash
	set -euo pipefail
	cd "{{PROJROOT}}/cli"
	uv run ruff format .
	uv run ruff check --fix .