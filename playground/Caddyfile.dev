https://forge.localhost:443 {
	# Locally-trusted certs generated by mkcert
	tls /certs/forge.localhost.pem /certs/forge.localhost-key.pem

	encode zstd gzip
	log

	# Proxy API preserving /api prefix
	@api {
		path /api/*
	}
	handle @api {
		reverse_proxy api:5050
	}

	# Everything else → Vite dev server
	handle {
		reverse_proxy frontend-dev:8080
	}
}

#! no port-80 listener in dev since host is already bound by OrbStack


