# Justfile for local playground: K3d + SetupV2 (contract-based parallel task runner)

PROJROOT := justfile_directory()

# Ensure recipes run under bash so arrays and [[ ]] work as written
set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

default:
	@just --list


# Create or reuse local cluster and deploy all services using setupv2
up:
	cd "{{PROJROOT}}" && uv run cli setupv2

# Tear down cluster
down name="forge":
    cd "{{PROJROOT}}" && uv run cli down --name {{name}}

# Apply base platform
apply:
	cd "{{PROJROOT}}/helmfile" && helmfile apply

# Sync base platform
sync:
	cd "{{PROJROOT}}/helmfile" && helmfile sync

# Run lint, formatting (check-only), and type checks
check:
	#!/usr/bin/env bash
	set -euo pipefail
	cd "{{PROJROOT}}"
	# Ensure tools resolve via uv without requiring a pre-synced venv
	uv run ruff check cli/
	uv run ruff format --check cli/
	# Run mypy using uv
	uv run mypy cli/

# CLI: auto-format and fix lint issues
format:
	#!/usr/bin/env bash
	set -euo pipefail
	cd "{{PROJROOT}}"
	uv run ruff format cli/
	uv run ruff check --fix cli/