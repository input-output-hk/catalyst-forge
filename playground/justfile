# Justfile for local playground: K3d + Helmfile (Envoy Gateway, registry)

PROJROOT := justfile_directory()

# Ensure recipes run under bash so arrays and [[ ]] work as written
set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

default:
	@just --list

# Run environment setup tasks
# Usage:
#   just setup                    # run all tasks
#   just setup hydra dns          # convenience: converts to --only hydra --only dns
#   just setup --only deploy      # pass flags through as-is when args start with --
setup *args:
	#!/usr/bin/env bash
	set -euo pipefail
	cd "{{PROJROOT}}/cli"
	# Populate positional parameters from Just variadic args so $#, $1, "$@" work
	set -- {{args}}
	if [ "$#" -eq 0 ]; then
		echo "Running all tasks"
		PYTHONPATH="{{PROJROOT}}/.." uv run python -m playground.cli.main setup
	else
		first="$1"
		if [[ "$first" == --* ]]; then
			echo "Passing flags through verbatim: $@"
			# Pass flags through verbatim
			PYTHONPATH="{{PROJROOT}}/.." uv run python -m playground.cli.main setup "$@"
		else
			echo "Treating args as task names, converting to repeated --only flags: $@"
			# Treat args as task names, convert to repeated --only flags
			args_conv=()
			for t in "$@"; do args_conv+=(--only "$t"); done
			PYTHONPATH="{{PROJROOT}}/.." uv run python -m playground.cli.main setup "${args_conv[@]}"
		fi
	fi

# Create or reuse local cluster and write kubeconfig/cluster.json
up: k3d apply pin-wildcard generate migrate deploy-all

# Tear down cluster
down name="forge":
    cd "{{PROJROOT}}/cli" && PYTHONPATH="{{PROJROOT}}/.." uv run python -m playground.cli.main down --name {{name}}

# Apply base platform
apply:
	cd "{{PROJROOT}}/helmfile" && helmfile apply

# Sync base platform
sync:
	cd "{{PROJROOT}}/helmfile" && helmfile sync

# Run lint, formatting (check-only), and type checks
check:
	#!/usr/bin/env bash
	set -euo pipefail
	cd "{{PROJROOT}}/cli"
	# Ensure tools resolve via uv without requiring a pre-synced venv
	uv run ruff check .
	uv run ruff format --check .
	# Run mypy using uv; set PYTHONPATH so package imports resolve
	PYTHONPATH="{{PROJROOT}}/.." uv run mypy .

# CLI: auto-format and fix lint issues
format:
	#!/usr/bin/env bash
	set -euo pipefail
	cd "{{PROJROOT}}/cli"
	uv run ruff format .
	uv run ruff check --fix .