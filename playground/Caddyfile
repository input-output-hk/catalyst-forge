https://forge.localhost {
	# Locally-trusted certs generated by mkcert
	tls /certs/forge.localhost.pem /certs/forge.localhost-key.pem

	encode zstd gzip
	log

	# Proxy API preserving /api prefix (backend expects /api/v1/*)
	@api {
		path /api/*
	}
	handle @api {
		reverse_proxy api:5050
	}

	# All other paths go to the frontend
	handle {
		reverse_proxy frontend:80
	}
}

forge.localhost:80 {
	redir https://{host}{uri}
}


