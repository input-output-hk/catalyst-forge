VERSION 0.8

deps:
    FROM node:20-bookworm-slim

    WORKDIR /work

    # Install dependencies
    COPY package.json package-lock.json .
    RUN npm ci

src:
    FROM +deps

    # Copy source files and config
    COPY --dir src examples tsconfig.json .prettierrc .eslintrc.json .

    SAVE ARTIFACT . src

generate:
    FROM +src

    COPY ../../api+swagger/docs /api/docs
    RUN npm run generate

    SAVE ARTIFACT src/api/schema.d.ts AS LOCAL src/api/schema.d.ts

bundle:
    FROM +generate

    RUN npm run build

    SAVE ARTIFACT dist/index.mjs dist/index.mjs
    SAVE ARTIFACT dist/index.d.ts dist/index.d.ts
    SAVE ARTIFACT src/api/schema.d.ts src/api/schema.d.ts

vendor:
    FROM +bundle

    RUN mkdir -p /out/forge-client \
        && cp dist/index.mjs /out/forge-client/index.mjs \
        && cp dist/index.d.ts /out/forge-client/index.d.ts \
        && cp src/api/schema.d.ts /out/forge-client/schema.d.ts \
        && printf '{\n  "type": "module",\n  "name": "forge-client",\n  "private": true,\n  "types": "./index.d.ts"\n}\n' > /out/forge-client/package.json \
        && printf '\nexport type { paths } from "./schema";\n' >> /out/forge-client/index.d.ts

    SAVE ARTIFACT /out/forge-client /forge-client

check:
    FROM +src

    COPY ../../api+swagger/docs /api/docs

    RUN npm run generate && git diff --exit-code src/api/schema.d.ts && echo "✓ OpenAPI types up-to-date"
    RUN npm run typecheck && echo "✓ TypeScript type checking passed"
    RUN npm run format:check && echo "✓ Code formatting check passed"


