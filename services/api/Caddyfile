# Caddy reverse proxy for local development
# Terminates TLS for api.localhost and proxies to the API container

api.localhost {
	# Use locally-trusted certs generated by scripts/dev-certs.sh (mkcert)
	tls /certs/api.localhost.pem /certs/api.localhost-key.pem

	encode zstd gzip
	log

	reverse_proxy api:5050
}

